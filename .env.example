# Supabase PostgreSQL connection string.
#
# Used by the Netlify Function (netlify/functions/api.ts) to reach the database.
# If unset, the function falls back to the built-in Supabase project defaults.
#
# Set this in:  Netlify → Site settings → Environment variables → add DATABASE_URL
# For local development with `netlify dev`, put it in a `.env` file (git-ignored).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Staff (admin dashboard) credentials.
#
# The admin panel lives at /admin and is opened with an ID + password pair.
# Without these variables the site falls back to the documented defaults:
#
#     ID       admin
#     PASSWORD gonit-ishkul
#
# Set your own before putting the site online — the sign-in screen hides the
# defaults automatically once they are overridden.
#
# ADMIN_SECRET (optional) signs the 12-hour staff session token. When it is
# unset the signature is derived from ADMIN_PASSWORD, so changing the password
# also invalidates old admin sessions.
#
# Set these in:  Netlify → Site configuration → Environment variables
# For local development with `netlify dev`, put them in a `.env` file (git-ignored).
# ADMIN_ID=admin
# ADMIN_PASSWORD=gonit-ishkul
# ADMIN_SECRET=change-me-to-a-long-random-string
