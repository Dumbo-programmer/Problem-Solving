{
  "name": "gonit-ishkul-problem-solving",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gonit Ishkul Problem Solving — a bilingual (Bangla/English) maths problem archive + instant-grading practice test platform, powered by Supabase/PostgreSQL.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-problem-bank.mjs",
    "preview": "vite preview",
    "netlify:dev": "netlify dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "node scripts/api-server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:cloud": "node scripts/smoke-cloud.mjs",
    "layout": "node scripts/layout-check.mjs",
    "db:verify": "node scripts/verify-problems.mjs"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@netlify/functions": "^3.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.5",
    "pg": "^8.13.1",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
